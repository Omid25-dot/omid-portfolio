# Public settings. Local origin must match the address used in your browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Equipment hire
NEXT_PUBLIC_SERVICE_REGION=Glasgow
# Optional real business contact; leave empty until supplied.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Keep demo/development deployments out of search engines.
NEXT_PUBLIC_INDEX_SITE=false
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (or publishable key); NEVER use the service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Ordinary user operations use the authenticated client, not this key.
SUPABASE_SERVICE_ROLE_KEY=
# Generate at least 32 random characters, e.g. openssl rand -hex 32.
# Used to sign short-lived recovery grants and hash rate-limit identities.
SECURITY_HMAC_SECRET=

# Upstash Redis REST endpoint/token. Required for auth requests and mutations.
# Missing credentials/provider failures BLOCK requests; there is no mock fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel supplies VERCEL=1 automatically; do not set it on untrusted local proxies.
# Other hosts use a shared source bucket until a trusted IP adapter is implemented.

# Reserved for future phases; not read/implemented in Phase 1.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
